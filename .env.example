APP_ENV=production
APP_URL=https://leaguecut.com
APP_KEY=BASE64_32_BYTES_GENERATED_LOCALLY
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=leaguecut
DB_USER=leaguecutuser
DB_PASSWORD=ROTACIONE_E_COLOQUE_FORA_DO_GIT
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@leaguecut.com
MAIL_FROM_NAME=LeagueCut
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE=clipador_aprovado
WHATSAPP_TEMPLATE_LANG=pt_BR

# Separate local WPPConnect session. Disabled until explicitly configured.
WPP_ENABLED=0
WPP_BASE_URL=http://127.0.0.1:21465
WPP_SESSION=leaguecut
WPP_AUTH_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=

# WebSocket somente após configuração do serviço PHP e proxy Nginx
REALTIME_WS_ENABLED=0

# Google Drive (Bloco 7): habilite a API Google Drive no Google Cloud.
# Cadastre https://leaguecut.com/admin/integracoes/google/callback como URI OAuth.
# Após inserir client ID/secret, conecte em /admin/integracoes.
# GOOGLE_REFRESH_TOKEN/GOOGLE_DRIVE_FOLDER_ID continuam suportados como modo legado.

# Apify Instagram views: scheduled every day at 02:00 Fortaleza (05:00 UTC) if token configured
# Actor: danek/instagram-posts-scraper-ppr (username + max_posts)
APIFY_API_TOKEN=
APIFY_MAX_POSTS=20
APIFY_MAX_RUN_CHARGE_USD=0.05
APIFY_DAILY_BUDGET_USD=0.15
APIFY_MAX_RUNS_PER_DAY=3
APIFY_MIN_HOURS_BETWEEN=24

# The collector uses exact post URLs with detailedData, under strict per-run/daily caps.
# Scheduling is controlled by .github/workflows/apify-metrics.yml; no pause flag.


# HYBRID OFFICIAL APIS — disabled until OAuth and staging E2E are approved
# Never commit real API keys, access tokens or app secrets.
HYBRID_SOCIAL_OAUTH_ENABLED=0
HYBRID_TIKTOK_SYNC_ENABLED=0
HYBRID_YOUTUBE_SYNC_ENABLED=0
HYBRID_SYNC_BATCH_SIZE=5
HYBRID_TIKTOK_SYNC_BATCH=5
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
YOUTUBE_API_KEY=

# Legacy Meta deauthorization endpoint remains for privacy requests from previous authorizations.
# Keep META_APP_SECRET only if your existing Meta app has active deauthorization callbacks.
META_APP_SECRET=

# Separate rollout authorization for each OAuth provider; default off.
HYBRID_TIKTOK_OAUTH_ENABLED=0

# B6D2b1: Web Push subscription storage (disabled until sender + VAPID enabled).
PUSH_REGISTRATION_ENABLED=0
# Future B6D2b2: define secret VAPID values ONLY in /home/leaguecut/shared/.env, never in Git.
PUSH_VAPID_PUBLIC=
PUSH_VAPID_PRIVATE=
PUSH_VAPID_SUBJECT=
